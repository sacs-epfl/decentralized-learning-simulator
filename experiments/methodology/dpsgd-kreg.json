{
  "version": 1,
  "name": "cifar10-32-dpsgd-kreg-joint-anytime-v2",
  "output": "../../output/leaderboard-v2/dpsgd-kreg-log2-anytime",
  "benchmark": {
    "budgets": [
      60,
      300,
      900
    ],
    "seeds": [
      110,
      111,
      112
    ],
    "evaluation_period": 60,
    "evaluation_model": "global",
    "execution_devices": [
      "cuda:0",
      "cuda:1",
      "cuda:0",
      "cuda:1",
      "cuda:0",
      "cuda:1",
      "cuda:0",
      "cuda:1"
    ],
    "accuracy_targets": [
      30,
      40,
      50,
      60,
      70,
      80
    ],
    "network": {
      "profile": "uniform",
      "bandwidth_bytes_per_second": 1000000,
      "compute_step_ms": 20
    }
  },
  "settings": {
    "dataset": "cifar10",
    "dataset_base_path": "../../data/cifar10",
    "model": "gnlenet",
    "device": "cuda:0",
    "peers": 32,
    "partitioner": "iid",
    "validation_set_fraction": 0.1,
    "evaluation_split": "test",
    "evaluation_examples": 0,
    "batch_size": 32,
    "momentum": 0,
    "weight_decay": 0,
    "network_latency_ms": 10,
    "torch_threads": 4,
    "synchronous": false
  },
  "runs": [
    {
      "name": "dpsgd-kreg-h01",
      "settings": {
        "algorithm": "dpsgd",
        "topology": "kreg",
        "k": 5,
        "local_steps": 1
      }
    },
    {
      "name": "dpsgd-kreg-h05",
      "settings": {
        "algorithm": "dpsgd",
        "topology": "kreg",
        "k": 5,
        "local_steps": 5
      }
    },
    {
      "name": "dpsgd-kreg-h10",
      "settings": {
        "algorithm": "dpsgd",
        "topology": "kreg",
        "k": 5,
        "local_steps": 10
      }
    }
  ],
  "tuning": {
    "budget": 900,
    "seeds": [
      100,
      101,
      102
    ],
    "evaluation_period": 60,
    "evaluation_examples": 0,
    "metric": "best_mean_accuracy",
    "select_variant": true,
    "learning_rates": {
      "dpsgd-kreg-h01": [
        0.001,
        0.003,
        0.01,
        0.03,
        0.1,
        0.3,
        1.0
      ],
      "dpsgd-kreg-h05": [
        0.001,
        0.003,
        0.01,
        0.03,
        0.1,
        0.3,
        1.0
      ],
      "dpsgd-kreg-h10": [
        0.001,
        0.003,
        0.01,
        0.03,
        0.1,
        0.3,
        1.0
      ]
    }
  }
}
