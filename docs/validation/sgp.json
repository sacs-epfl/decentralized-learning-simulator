    "commit": "e682064d3f0a6216868f8528f804afe091af19b8",
    "contract": "Plain SGP Algorithm 1: evaluate gradient at z=x/w; x_half=x-lr*g(z); mix numerator and scalar mass using sender-column weights; recover z=x/w. One gradient and one blocking directed neighbor exchange per iteration.",
    "scope": "Stable membership; fully trainable parameters; local_steps=1; momentum=0; local buffers. Default forward one-peer exponential schedule from Appendix A; additional directed ring, irregular ring+0to2, and complete controls. No Overlap SGP, momentum/Adam, multiple exponential peers, losses, churn or LoRA.",
    "weight_decay": "Optional objective gradient correction weight_decay*z. Reference comparison and screening use zero decay.",
    "historical_branch": "origin/pushsum inspected as historical context only; a separate user experimental protocol, not used as the SGP implementation."
  },
  "environment": {
    "conda_prefix": "/mnt/data/mdevos/conda/envs/conflux-gpu",
    "python": "3.12.15",
    "torch": "2.14.1+cu130",
    "numpy": "2.5.4",
